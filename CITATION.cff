message: "Please cite this software when using its code or reference data."
title: "Secant methods on Lie groups: code and reference data"
type: software
version: "3.0.0"
authors:
  - family-names: Astudillo
    given-names: "María del Pilar"
    orcid: "https://orcid.org/0009-0002-9477-4957"
  - family-names: Castro
    given-names: Rodrigo
    orcid: "https://orcid.org/0000-0003-0010-7775"
