message: "If you use this software, please cite the archived Zenodo release."

title: "Reproducibility code for the secant method on Lie groups via divided differences"
type: software
version: "2.0.0"
date-released: "2026-08-27"

authors:
  - family-names: Astudillo
    given-names: "María del Pilar"
    orcid: "https://orcid.org/0009-0002-9477-4957"
  - family-names: Castro
    given-names: "Rodrigo"
    orcid: "https://orcid.org/0000-0003-0010-7775"
  - family-names: Sierra
    given-names: "Willy"
